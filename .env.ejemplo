# Copia este archivo con el nombre .env y rellena tus datos.
# Si no existe .env, los emails no se envían: se muestran en la consola.

# Dirección donde está publicada la app (se usa en el enlace del email)
BASE_URL=http://127.0.0.1:5000

# Ejemplo con Gmail: necesitas una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tucorreo@gmail.com
